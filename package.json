{
  "name": "papertrail-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "PaperTrail — Multi-Platform Personal Document Vault (React Web, Expo Mobile, NestJS Backend)",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @papertrail/web dev",
    "dev:api": "pnpm --filter @papertrail/api start:dev",
    "dev:mobile": "pnpm --filter @papertrail/mobile start",
    "dev:worker": "pnpm --filter @papertrail/worker dev",
    "db:generate": "pnpm --filter @papertrail/api prisma:generate",
    "db:push": "pnpm --filter @papertrail/api prisma:push"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "turbo": "^2.4.4",
    "typescript": "~5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@google/genai",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "browser-tabs-lock",
      "bufferutil",
      "core-js",
      "esbuild",
      "prisma",
      "protobufjs",
      "utf-8-validate"
    ]
  }
}
