# ==============================================================================
# PAPERTRAIL WEB & MOBILE CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Clerk Authentication Publishable Key (from Clerk Dashboard > API Keys)
# Format: pk_test_... (Development) or pk_live_... (Production)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# NestJS Vault API Base URL
VITE_API_URL=http://localhost:3000

# Optional: Cloudflare R2 Public CDN / Custom Domain for Document Previews
# VITE_R2_PUBLIC_URL=https://vault-cdn.papertrail.io
