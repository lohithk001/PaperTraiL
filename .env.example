# ==============================================================================
# PAPERTRAIL MONOREPO ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_secret@ep-vault-prod.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# CLERK_JWT_KEY=your_clerk_jwt_key_here

# Backend API & Storage
VITE_API_URL=http://localhost:3000
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_r2_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=papertrail-vault-documents
GEMINI_API_KEY=your_gemini_api_key_here
