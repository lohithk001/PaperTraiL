# PaperTrail Client Configuration
# Copy this file to .env.local to override default development settings.

# Port for the Vite development server (Default: 5173)
VITE_PORT=5173

# Application Title displayed in browser
VITE_APP_TITLE="PaperTrail — Personal Document Vault"

# Future Backend API Endpoint (Optional / Planned)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
